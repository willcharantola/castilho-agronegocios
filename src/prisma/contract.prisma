// use prisma-next
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

model Empresa {
  empresaId Int         @id(map: "empresa_pkey") @default(autoincrement()) @map("empresa_id")
  cnpj      VarChar(18)
  creci     VarChar(20)
  nome      VarChar(50)
  negocios  Negocio[]
  usuarios  Usuario[]

  @@map("empresa")
}

model Negocio {
  negocioId         Int             @id(map: "negocio_pkey") @default(autoincrement()) @map("negocio_id")
  empresaId         Int             @map("empresa_id")
  valorTotal        Numeric(15, 2)? @map("valor_total")
  valorMedio        Numeric(15, 2)? @map("valor_medio")
  vendedor          VarChar(50)
  fazenda           VarChar(50)
  merchant          VarChar(50)
  comprador         VarChar(50)?
  qtdAnimais        Int?            @map("qtd_animais")
  rendimentoCarcaca Numeric(5, 2)   @map("rendimento_carcaca")
  maisPesado        Numeric(15, 2)? @map("mais_pesado")
  maisLeve          Numeric(15, 2)? @map("mais_leve")
  dataNegocio       TimestampString @map("data_negocio")
  comissao          Numeric(15, 2)
  valorArroba       Numeric(15, 2)  @map("valor_arroba")
  modalidade        VarChar(20)
  gados             Gado[]
  empresa           Empresa         @relation(fields: [empresaId], references: [empresaId], map: "negocio_empresa_id_fkey", index: false)

  @@check(expression: "((rendimento_carcaca >= (0)::numeric) AND (rendimento_carcaca <= (100)::numeric))", map: "negocio_rendimento_carcaca_check")
  @@map("negocio")
}

model Gado {
  gadoId      Int             @id(map: "gado_pkey") @default(autoincrement()) @map("gado_id")
  negocioId   Int             @map("negocio_id")
  valorTotal  Numeric(15, 2)? @map("valor_total")
  pesoArroba  Numeric(15, 2)  @map("peso_arroba")
  pesoCalculo Numeric(15, 2)  @map("peso_calculo")
  pesoTotal   Numeric(15, 2)  @map("peso_total")
  dataPesagem TimestampString? @map("data_pesagem")
  genero      VarChar(6)
  denominacao VarChar(20)
  negocio     Negocio         @relation(fields: [negocioId], references: [negocioId], map: "gado_negocio_id_fkey", index: false)

  @@check(expression: "((genero)::text = ANY ((ARRAY['Macho'::character varying, 'Femea'::character varying])::text[]))", map: "gado_genero_check")
  @@map("gado")
}

model Usuario {
  userId    Int          @id(map: "usuario_pkey") @default(autoincrement()) @map("user_id")
  empresaId Int          @map("empresa_id")
  nome      VarChar(50)
  sobrenome VarChar(50)
  email     VarChar(254) @unique(map: "usuario_email_key")
  senha     VarChar(255)
  empresa   Empresa      @relation(fields: [empresaId], references: [empresaId], map: "usuario_empresa_id_fkey", index: false)

  @@map("usuario")
}
